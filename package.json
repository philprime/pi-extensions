{
  "name": "@philprime/pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Personal extensions for the Pi coding agent",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:skills": "bash skills/iterate-pr/tests/iterate-pr.test.sh",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:skills"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@types/node": "26.6.3",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pi": {
    "extensions": [
      "./extensions/compaction-context.ts",
      "./extensions/footer.ts",
      "./extensions/permissions.ts",
      "./extensions/run.ts",
      "./extensions/tasks.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
